# Copy this to .env.local to override the defaults baked in at build time.
# Gateways stays/apps keep working with the docker-compose defaults,
# so you normally don't need this file at all.

# The API Gateway (host port 18080 -> container 8085), see docker-compose.yml.
VITE_API_BASE_URL=http://localhost:18080/api

# Local OSRM (docker-compose osrm service) used for the display route maps;
# falls back to https://router.project-osrm.org then a straight line.
VITE_OSRM_BASE_URL=http://localhost:5000